+def _find_emotion_root(base):
+    """
+    Walk *base* and return the first directory whose immediate children are
+    image class folders (each subdir directly contains image files).
+
+    Handles both flat layouts  (base/angry/, base/happy/, …)  and split
+    layouts  (base/train/angry/, base/train/happy/, …).  The walk always
+    returns the class-folder parent, never the class folders themselves.
+    """
+    import os as _os
+    IMG_EXTS = {".jpg", ".jpeg", ".png", ".bmp", ".tiff", ".webp"}
+    for root, dirs, _ in _os.walk(base):
+        dirs.sort()
+        if len(dirs) < 2:
+            continue
+        # Peek inside the first subdir to see whether it holds images
+        sample_sub = _os.path.join(root, dirs[0])
+        try:
+            contents = _os.listdir(sample_sub)
+        except PermissionError:
+            continue
+        has_images = any(
+            _os.path.splitext(f)[1].lower() in IMG_EXTS for f in contents
+        )
+        if has_images:
+            return root          # this is the class-folder level
+    return base                  # fall back to supplied root
+
