+def get_narcissus_caltech256_poisoned_data(
+    pr_tgt,
+    target_class,
+    dataset_dir,
+    model,
+    eps,
+    global_seed,
+    img_size=112,
+    surrogate_epochs=5,
+    gen_steps=200,
+    batch_size=64,
+    device=None,
+):
+    """
+    Generate a Narcissus clean-label backdoor dataset for Caltech-256.
+
+    Steps
+    -----
+    1. Load Caltech-256 via ImageFolder (same transform as main.py).
+    2. Replace the model's final Linear layer in-place for num_classes.
+    3. 80/20 train/test split (same generator seed as main.py).
+    4. Train a surrogate model on clean data for `surrogate_epochs` epochs.
+    5. Generate a universal trigger via PGD on target-class images.
+    6. Poison `pr_tgt` fraction of target-class training images.
+    7. Build a poisoned test set (all target-class test images carry the trigger).
+
+    Returns
+    -------
+    poisoned_train_dataset, test_dataset, poisoned_test_dataset, poison_indices
+        poison_indices : list of positional indices (0-based) within
+                         poisoned_train_dataset that are poisoned.
+    """
+    from torchvision.datasets import ImageFolder
+    from torchvision import transforms
+    from torch.utils.data import random_split
+
+    if device is None:
+        device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
+
+    # ── 1. Dataset ────────────────────────────────────────────────────────────
+    tfm = transforms.Compose([
+        transforms.Resize(img_size),
+        transforms.CenterCrop(img_size),
+        transforms.ToTensor(),
+        transforms.Normalize(mean=[0.485, 0.456, 0.406],
+                             std=[0.229, 0.224, 0.225]),
+    ])
+    full_ds    = ImageFolder(dataset_dir, transform=tfm)
+    num_classes = len(full_ds.classes)
+    all_labels  = full_ds.targets          # list[int], length = len(full_ds)
+    print(f"Caltech-256: {len(full_ds)} images, {num_classes} classes")
+
+    # ── 2. Replace model head ─────────────────────────────────────────────────
+    if hasattr(model, 'fc') and isinstance(model.fc, nn.Linear):
+        model.fc = nn.Linear(model.fc.in_features, num_classes)
+        print(f"Replaced fc -> out_features={num_classes}")
+    else:
+        _last_name, _last_mod = None, None
+        for _nm, _md in model.named_modules():
+            if isinstance(_md, nn.Linear):
+                _last_name, _last_mod = _nm, _md
+        if _last_mod is None:
+            raise ValueError("No nn.Linear found in model")
+        _par = model
+        for _pt in _last_name.split('.')[:-1]:
+            _par = getattr(_par, _pt)
+        setattr(_par, _last_name.split('.')[-1],
+                nn.Linear(_last_mod.in_features, num_classes))
+        print(f"Replaced {_last_name} -> out_features={num_classes}")
+
+    # ── 3. Train / test split ─────────────────────────────────────────────────
+    g       = torch.Generator().manual_seed(global_seed)
+    n       = len(full_ds)
+    n_train = int(0.8 * n)
+    n_test  = n - n_train
+    train_subset, test_subset = random_split(full_ds, [n_train, n_test], generator=g)
+
+    # Positional indices within train_subset that belong to target_class
+    train_target_pos = [
+        pos for pos, fi in enumerate(train_subset.indices)
+        if all_labels[fi] == target_class
+    ]
+    test_target_pos = [
+        pos for pos, fi in enumerate(test_subset.indices)
+        if all_labels[fi] == target_class
+    ]
+    print(f"Target class {target_class}: "
+          f"{len(train_target_pos)} train, {len(test_target_pos)} test images")
+
+    # ── 4. Surrogate training ─────────────────────────────────────────────────
+    surrogate = copy.deepcopy(model).to(device)
+    sur_opt   = torch.optim.SGD(
+        surrogate.parameters(), lr=0.01, momentum=0.9, weight_decay=5e-4,
+    )
+    sur_sched = torch.optim.lr_scheduler.CosineAnnealingLR(
+        sur_opt, T_max=surrogate_epochs,
+    )
+    criterion = nn.CrossEntropyLoss()
+
+    clean_loader = DataLoader(
+        train_subset, batch_size=batch_size, shuffle=True,
+        num_workers=0, pin_memory=True,
+    )
+    print(f"Training surrogate for {surrogate_epochs} epochs "
+          f"({n_train} samples, bs={batch_size}) …")
+    surrogate.train()
+    for ep in range(surrogate_epochs):
+        for x, y in clean_loader:
+            x, y = x.to(device), y.to(device)
+            sur_opt.zero_grad()
+            criterion(surrogate(x), y).backward()
+            sur_opt.step()
+        sur_sched.step()
+        print(f"  Surrogate epoch {ep + 1}/{surrogate_epochs}")
+    surrogate.eval()
+    # Free training state — optimizer, scheduler, criterion, and loader all hold
+    # GPU tensors / references that would otherwise survive into PGD generation.
+    del sur_opt, sur_sched, criterion, clean_loader
+    # Freeze surrogate weights so autograd only tracks trigger → loss, not the
+    # 11M surrogate parameters.  Cuts per-batch activation memory ~30 %.
+    for p in surrogate.parameters():
+        p.requires_grad_(False)
+    torch.cuda.empty_cache()
+
+    # ── 5. Trigger generation (PGD) ───────────────────────────────────────────
+    eps_float = eps / 255.0      # L-inf bound in normalised image space
+
+    # DataLoader over target-class training images only
+    target_train_sub = Subset(train_subset, train_target_pos)
+    tgt_loader = DataLoader(
+        target_train_sub,
+        batch_size=min(batch_size, len(target_train_sub)),
+        shuffle=True, num_workers=0,
+    )
+
+    torch.manual_seed(global_seed)
+    trigger = torch.zeros(1, 3, img_size, img_size, device=device)
+    lr_pgd  = eps_float / 10.0
+
+    print(f"Generating Narcissus trigger "
+          f"({gen_steps} PGD steps, eps={eps}/255) …")
+    for step in range(gen_steps):
+        if step % 10 == 0 or step == gen_steps - 1:
+            print(f"  PGD step {step + 1}/{gen_steps}", flush=True)
+        trigger.requires_grad_(True)
+        # Per-batch backward: releases each batch's computation graph immediately
+        # instead of holding all 40 batches in VRAM simultaneously.
+        for x, y in tgt_loader:
+            x   = x.to(device)
+            x_p = torch.clamp(x + trigger, -3.0, 3.0)
+            logits = surrogate(x_p)
+            tgt = torch.full((x.size(0),), target_class,
+                             dtype=torch.long, device=device)
+            loss = -F.cross_entropy(logits, tgt)
+            loss.backward()          # grad accumulates into trigger.grad
+            del x, x_p, logits, tgt, loss
+        with torch.no_grad():
+            trigger = trigger - lr_pgd * trigger.grad.sign()
+            trigger = torch.clamp(trigger, -eps_float, eps_float)
+        trigger = trigger.detach()
+
+    trigger_cpu = trigger.squeeze(0).cpu()   # [C, H, W]
+    print(f"Trigger L-inf: {trigger_cpu.abs().max().item():.4f}")
+
+    # ── 6. Select samples to poison ───────────────────────────────────────────
+    n_poison   = max(1, int(len(train_target_pos) * pr_tgt / 100))  # FIX D4: pr_tgt is a percentage
+    rng        = np.random.default_rng(global_seed)
+    poison_pos = list(rng.choice(train_target_pos, n_poison, replace=False).tolist())
+    print(f"Poisoning {n_poison}/{len(train_target_pos)} target-class train samples")
+
+    # ── 7. Build poisoned datasets ────────────────────────────────────────────
+    poisoned_train_ds = _PoisonedDataset(
+        train_subset, poison_pos, trigger_cpu,
+        clamp_min=-3.0, clamp_max=3.0,
+    )
+    # Poisoned test: every target-class test image carries the trigger
+    poisoned_test_ds = _PoisonedDataset(
+        test_subset, test_target_pos, trigger_cpu,
+        clamp_min=-3.0, clamp_max=3.0,
+    )
+
+    poison_indices = poison_pos   # positional indices into poisoned_train_ds
+
+    return poisoned_train_ds, test_subset, poisoned_test_ds, poison_indices
+
