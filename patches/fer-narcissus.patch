+# ---------------------------------------------------------------------------
+# Dataset wrappers
+# ---------------------------------------------------------------------------
+
+class _IndexedDataset(torch.utils.data.Dataset):
+    """
+    Adds the positional index as a 3rd return value for datasets that yield
+    only 2-tuples (img, label).  Datasets already returning 3-tuples are
+    passed through unchanged.
+    """
+    def __init__(self, base):
+        self.base = base
+
+    def __len__(self):
+        return len(self.base)
+
+    def __getitem__(self, idx):
+        sample = self.base[idx]
+        if len(sample) >= 3:
+            return sample
+        return sample[0], sample[1], idx
+
+
+class _PoisonedDataset(torch.utils.data.Dataset):
+    """
+    Wraps a clean dataset and applies a fixed trigger tensor to a specified
+    set of positional indices.
+
+    Args:
+        base           : base dataset (returns 2-tuples)
+        poison_indices : list/set of positional indices to poison
